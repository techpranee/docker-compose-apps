# CopilotKit Environment Configuration (Stateless + Hosted Services)
# Copy this file to .env and update the values as needed

# === LLM Configuration (Hosted Ollama) ===
# Hosted Ollama base URL (replace with your actual hosted endpoint)
OLLAMA_BASE_URL=https://ollama2.havenify.ai

# Ollama model to use on your hosted instance
# Popular options: llama2, mistral, codellama, phi3, gemma
OLLAMA_MODEL=deepseek-r1:14b

# === Database Configuration (Hosted RDS) ===
# Replace with your actual RDS connection string
# Example: postgresql://username:password@your-rds-endpoint:5432/copilotkit
DATABASE_URL=postgresql://postgres:techpranee@techpranee.csghg5x1e4dy.ap-south-1.rds.amazonaws.com:5432/copilotkit

# RDS connection details (for Adminer - OPTIONAL)
# Adminer will work with just RDS_HOST, you can login manually in the web interface
# Or set these to pre-fill the login form
RDS_HOST=techpranee.csghg5x1e4dy.ap-south-1.rds.amazonaws.com
# RDS_USER=postgres          # Optional: uncomment to pre-fill login
# RDS_PASSWORD=techpranee    # Optional: uncomment to pre-fill login
# RDS_DATABASE=copilotkit    # Optional: uncomment to pre-fill login

# Example using your pattern from Langflow:
# DATABASE_URL=postgresql://postgres:techpranee@techpranee.csghg5x1e4dy.ap-south-1.rds.amazonaws.com:5432/copilotkit
# RDS_HOST=techpranee.csghg5x1e4dy.ap-south-1.rds.amazonaws.com
# RDS_USER=postgres
# RDS_PASSWORD=techpranee
# RDS_DATABASE=copilotkit

# === Security ===
# JWT Secret for authentication (change this to a random secure string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Redis password
REDIS_PASSWORD=copilotkit

# === CORS Configuration ===
# Allowed origins for CORS (comma-separated for multiple origins)
CORS_ORIGIN=*

# === Logging ===
# Log level: error, warn, info, debug
LOG_LEVEL=info

# === Application Configuration ===
# Node environment
NODE_ENV=production

# External URLs (if using custom domains with Nginx Proxy Manager)
# COPILOTKIT_URL=https://your-domain.com
# FRONTEND_URL=https://your-frontend-domain.com

# === Legacy OpenAI Configuration (if you want to switch back) ===
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini