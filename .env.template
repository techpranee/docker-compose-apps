# Postiz Environment Variables Template
# Copy these variables to your Portainer environment variables section

# === REQUIRED VARIABLES ===
# Main application URLs - Replace with your actual domain
POSTIZ_MAIN_URL=https://postiz.your-server.com
POSTIZ_FRONTEND_URL=https://postiz.your-server.com
POSTIZ_BACKEND_URL=https://postiz.your-server.com/api

# Security - Generate a secure random string for JWT
POSTIZ_JWT_SECRET=your-super-secure-jwt-secret-here-make-it-long-and-random

# AWS PostgreSQL Database - Replace with your actual AWS RDS connection string
POSTIZ_DATABASE_URL=postgresql://your-aws-db-user:your-aws-db-password@your-aws-db-endpoint:5432/your-aws-db-name

# === OPTIONAL VARIABLES (with defaults) ===
# Port mapping (defaults to 5000 if not set)
POSTIZ_PORT=5000

# Redis URL (defaults to local redis container if not set)
POSTIZ_REDIS_URL=redis://postiz-redis:6379

# Backend internal URL (defaults to localhost:3000 if not set)
POSTIZ_BACKEND_INTERNAL_URL=http://localhost:3000

# Application settings (defaults provided)
POSTIZ_IS_GENERAL=true
POSTIZ_DISABLE_REGISTRATION=false

# Storage settings (defaults to local storage)
POSTIZ_STORAGE_PROVIDER=local
POSTIZ_UPLOAD_DIRECTORY=/uploads
POSTIZ_NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# === PORTAINER SETUP INSTRUCTIONS ===
# 1. In Portainer, go to Stacks
# 2. Create a new stack or edit existing one
# 3. In the "Environment variables" section, add each variable above
# 4. Replace the example values with your actual configuration
# 5. Deploy the stack

# === SECURITY NOTES ===
# - Never commit actual secrets to version control
# - Use strong, unique passwords for database connections
# - Generate a secure JWT secret (at least 32 characters)
# - Use HTTPS for all public URLs
