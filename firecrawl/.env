# =========================
# Firecrawl stack defaults
# =========================

# Core runtime configuration
FIRECRAWL_ENV=production
FIRECRAWL_HTTP_PORT=3002
FIRECRAWL_INTERNAL_PORT=3002
FIRECRAWL_WORKER_PORT=3005
NUM_WORKERS_PER_QUEUE=8
USE_DB_AUTHENTICATION=false
LOGGING_LEVEL=info
BULL_AUTH_KEY=CHANGEME

# Data stores
REDIS_URL=redis://redis:6379
REDIS_RATE_LIMIT_URL=${REDIS_URL}

# Required: managed Postgres connection (e.g. AWS RDS)
NUQ_DATABASE_URL=postgresql://postgres:techpranee@techpranee.csghg5x1e4dy.ap-south-1.rds.amazonaws.com:5432/firecrawl
NUQ_DATABASE_URL_LISTEN=${NUQ_DATABASE_URL}

# Worker networking (used when authentication is enabled)
FIRECRAWL_APP_HOST=firecrawl-api
FIRECRAWL_APP_PORT=${FIRECRAWL_INTERNAL_PORT}
FIRECRAWL_APP_SCHEME=http

# Optional: LLM integrations
OPENAI_API_KEY=
OPENAI_BASE_URL=
MODEL_NAME=deepseek-r1:14b
MODEL_EMBEDDING_NAME=
OLLAMA_BASE_URL=https://ollama2.havenify.ai/api

# Optional: Search providers
SERPER_API_KEY=
SEARCHAPI_API_KEY=
SEARCHAPI_ENGINE=
SEARXNG_ENDPOINT=
SEARXNG_ENGINES=
SEARXNG_CATEGORIES=

# Optional: Webhooks and analytics
SELF_HOSTED_WEBHOOK_URL=
SELF_HOSTED_WEBHOOK_HMAC_SECRET=
SLACK_WEBHOOK_URL=
POSTHOG_API_KEY=
POSTHOG_HOST=
TEST_API_KEY=

# Optional: Supabase (only needed when USE_DB_AUTHENTICATION=true)
SUPABASE_URL=
SUPABASE_ANON_TOKEN=
SUPABASE_SERVICE_TOKEN=

# Optional: Proxy settings for Playwright service
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=
BLOCK_MEDIA=false

# Optional: Additional services
LLAMAPARSE_API_KEY=
RESEND_API_KEY=

